{
  "name": "@aeonsule/flow-insight",
  "version": "0.1.41",
  "type": "module",
  "description": "A React component library for Flow visualization and insights",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "keywords": [
    "flow",
    "visualization",
    "insight",
    "debug",
    "react",
    "component"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime": "7.12",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.15.5",
    "@mui/material": "^5.17.1",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.52",
    "@types/dagre-d3": "^0.6.6",
    "axios": "^0.21.1",
    "boxicons": "^2.1.4",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dagre-d3": "^0.6.4",
    "framer-motion": "^12.8.2",
    "js-tiktoken": "^1.0.19",
    "mermaid": "^11.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-window": "^1.8.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "slashes": "^3.0.12"
  },
  "devDependencies": {
    "@types/d3": "^7.0.0",
    "@types/dagre": "^0.7.0",
    "@types/node": "^22.14.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-syntax-highlighter": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tslib": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^4.9.0"
  }
}
