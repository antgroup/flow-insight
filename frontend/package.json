{
  "name": "@aeonsule/flow-insight",
  "version": "0.9.16",
  "type": "module",
  "description": "A React component library for distributed system visualization and insights",
  "main": "dist/index.js",
  "author": "ant-ray group",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}'",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "keywords": [
    "flow",
    "visualization",
    "insight",
    "debug",
    "react",
    "component"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime": "7.12",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.15.5",
    "@mui/material": "^5.17.1",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.52",
    "@types/dagre-d3": "^0.6.6",
    "axios": "^0.21.1",
    "boxicons": "^2.1.4",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dagre-d3": "^0.6.4",
    "framer-motion": "^12.8.2",
    "gantt-task-react": "^0.3.9",
    "js-tiktoken": "^1.0.19",
    "lucide-react": "^0.503.0",
    "mermaid": "^11.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-window": "^1.8.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "slashes": "^3.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/d3": "^7.0.0",
    "@types/dagre": "^0.7.0",
    "@types/node": "^22.14.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-syntax-highlighter": "^15.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.3",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^14.0.0",
    "postcss": "^8.5.3",
    "postcss-modules": "^6.0.1",
    "prettier": "^3.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^4.9.0"
  }
}